# OpenSCAD MCP Server Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# API Keys
# ======================

# Google Gemini API Key for image generation
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Venice.ai API Key (optional) for alternative image generation
# Get your API key from: https://venice.ai/
VENICE_API_KEY=your_venice_api_key_here

# ======================
# CUDA Multi-View Stereo Configuration (Local)
# ======================

# Path to CUDA MVS installation (if using local processing)
CUDA_MVS_PATH=/app/cuda-mvs

# Whether to use GPU for CUDA MVS (set to false for CPU-only)
CUDA_MVS_USE_GPU=false

# ======================
# Remote CUDA MVS Configuration
# ======================

# Enable remote CUDA MVS processing
REMOTE_CUDA_MVS_ENABLED=true

# Use LAN discovery to find CUDA MVS servers
REMOTE_CUDA_MVS_USE_LAN_DISCOVERY=true

# Direct server URL (leave empty to use LAN discovery)
REMOTE_CUDA_MVS_SERVER_URL=

# API key for remote CUDA MVS server
REMOTE_CUDA_MVS_API_KEY=your_remote_cuda_mvs_api_key_here

# Discovery port for LAN discovery
REMOTE_CUDA_MVS_DISCOVERY_PORT=8765

# Connection timeout (seconds)
REMOTE_CUDA_MVS_CONNECTION_TIMEOUT=10

# Upload/download chunk sizes (bytes)
REMOTE_CUDA_MVS_UPLOAD_CHUNK_SIZE=1048576
REMOTE_CUDA_MVS_DOWNLOAD_CHUNK_SIZE=1048576

# Retry configuration
REMOTE_CUDA_MVS_MAX_RETRIES=3
REMOTE_CUDA_MVS_BASE_RETRY_DELAY=1.0
REMOTE_CUDA_MVS_MAX_RETRY_DELAY=60.0
REMOTE_CUDA_MVS_JITTER_FACTOR=0.1

# Health check configuration
REMOTE_CUDA_MVS_HEALTH_CHECK_INTERVAL=60
REMOTE_CUDA_MVS_CIRCUIT_BREAKER_THRESHOLD=5
REMOTE_CUDA_MVS_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0

# Processing parameters
REMOTE_CUDA_MVS_DEFAULT_QUALITY=normal
REMOTE_CUDA_MVS_DEFAULT_FORMAT=obj
REMOTE_CUDA_MVS_WAIT_FOR_COMPLETION=true
REMOTE_CUDA_MVS_POLL_INTERVAL=5

# ======================
# Image Approval Configuration
# ======================

# Enable image approval workflow
IMAGE_APPROVAL_ENABLED=true

# Auto-approve images (set to true to skip manual approval)
IMAGE_APPROVAL_AUTO_APPROVE=false

# Approval timeout (seconds)
IMAGE_APPROVAL_TIMEOUT=300

# Minimum number of approved images required
IMAGE_APPROVAL_MIN_IMAGES=3

# ======================
# Multi-view Configuration
# ======================

# Default number of views to generate
MULTI_VIEW_DEFAULT_NUM_VIEWS=4

# Minimum and maximum number of views
MULTI_VIEW_MIN_NUM_VIEWS=3
MULTI_VIEW_MAX_NUM_VIEWS=8

# ======================
# Natural Language Processing Configuration
# ======================

# Enable interactive parameter extraction
NLP_ENABLE_INTERACTIVE_PARAMS=true

# ======================
# Deprecated/Legacy Configuration
# ======================

# SAM2 Segmentation (deprecated but kept for reference)
# SAM2_CHECKPOINT_PATH=/app/models/sam2_vit_b.pth
# SAM2_MODEL_TYPE=vit_b
# SAM2_USE_GPU=false

# ThreeStudio (deprecated but kept for reference)
# THREESTUDIO_PATH=/app/threestudio

# ======================
# Docker-specific Configuration
# ======================

# Python environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1 